# Test: Force a spill — StoreMove saves to stack, LoadMove reloads.
# Two vregs, force one to spill even though registers are available.
#
# RUN: llc -mtriple=riscv64 -load %libunison -regalloc=unison \
# RUN:   -unison-preassign=%S/codegen-spill.vars %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: codegen_spill:
# CHECK:       sd {{[a-z0-9]+}}, {{[0-9]+}}(sp)
# CHECK:       ld {{[a-z0-9]+}}, {{[0-9]+}}(sp)
# CHECK:       ret
--- |
  define signext i64 @codegen_spill(i64 signext %a, i64 signext %b) {
    %c = add i64 %a, %b
    ret i64 %c
  }
...
---
name:            codegen_spill
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = ADD %0, %1
    $x10 = COPY %2
    PseudoRET implicit $x10
...
