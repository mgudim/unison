# Test: Force rematerialization instead of spill/reload.
# An ADDI with immediate operand is rematerializable.
# Pre-assign the LoadMove as COPY_REMAT to re-emit the ADDI.
#
# RUN: llc -mtriple=riscv64 -load %libunison -regalloc=unison \
# RUN:   -unison-preassign=%S/codegen-remat.vars %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: codegen_remat:
# The rematerialized ADDI should appear twice (original + remat).
# CHECK:       li
# CHECK:       li
# CHECK:       add
# CHECK:       ret
--- |
  define i64 @codegen_remat(i64 %a) {
    %b = add i64 %a, 42
    %c = add i64 %b, %a
    ret i64 %c
  }
...
---
name:            codegen_remat
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10
    %1:gpr = ADDI $x0, 42
    %2:gpr = ADD %0, %1
    $x10 = COPY %2
    PseudoRET implicit $x10
...
