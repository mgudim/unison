# Test: Rematerialization — ADDI with immediate is rematerializable.
#
# RUN: llc -mtriple=riscv64 -load %libunison -run-pass=regallocunison %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: codegen_remat
# CHECK: $x11 = ADDI $x0, 42
# CHECK: $x10 = ADD $x10, $x11
# CHECK: PseudoRET implicit $x10
--- |
  define i64 @codegen_remat(i64 %a) {
    %b = add i64 %a, 42
    %c = add i64 %b, %a
    ret i64 %c
  }
...
---
name:            codegen_remat
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10
    %1:gpr = ADDI $x0, 42
    %2:gpr = ADD %0, %1
    $x10 = COPY %2
    PseudoRET implicit $x10
...
