# Test: Basic allocation — one vreg, no register pressure.
# The vreg %0 is defined and used with no conflicting physreg live ranges.
# Expected: %0 assigned to any caller-saved register, no spills.
#
# RUN: llc -mtriple=riscv64 -load %libunison -regalloc=unison %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: basic_alloc:                            # @basic_alloc
# CHECK:       mv	a2, a0
# CHECK:       mv	a3, a1
# CHECK:       add	a1, a2, a3
# CHECK:       mv	a0, a1
# CHECK:       ret
--- |
  define i64 @basic_alloc(i64 %a, i64 %b) {
    %r = add i64 %a, %b
    ret i64 %r
  }
...
---
name:            basic_alloc
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
body:             |
  bb.0:
    liveins: $x10, $x11
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = ADD %0, %1
    $x10 = COPY %2
    PseudoRET implicit $x10
...
