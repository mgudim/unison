# Test: Register-to-register move — default solver behavior.
#
# RUN: llc -mtriple=riscv64 -load %libunison -run-pass=regallocunison %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: codegen_move
# CHECK: $x10 = ADD $x10, $x11
# CHECK: PseudoRET implicit $x10
--- |
  define i64 @codegen_move(i64 %a, i64 %b) {
    %c = add i64 %a, %b
    ret i64 %c
  }
...
---
name:            codegen_move
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11
    %0:gpr = COPY $x10
    %1:gpr = COPY $x11
    %2:gpr = ADD %0, %1
    $x10 = COPY %2
    PseudoRET implicit $x10
...
