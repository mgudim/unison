# Force %0 into callee-saved register s0 (reg 15) across the call.
# The StoreMove (COPY_MOVE to s0) and LoadMove (COPY_MOVE from s0)
# must be active to save/restore across the call.
MBB0.RI1.d0.SM.active = 1
MBB0.RI1.d0.SM.ins = 1
MBB0.RI1.d0.LM_MBB0.RI5.active = 1
MBB0.RI1.d0.LM_MBB0.RI5.ins = 1
MBB0.RI5.use[0].choice = 1
