# Force a register-to-register move: activate a LoadMove as COPY_MOVE.
# %0 (from $x10) gets moved to a different register before ADD uses it.
MBB0.LI.d0.SM.active = 1
MBB0.LI.d0.SM.ins = COPY_MOVE
MBB0.LI.d0.LM_MBB0.RI0.active = 1
MBB0.LI.d0.LM_MBB0.RI0.ins = COPY_MOVE
MBB0.RI0.use[0].choice = MBB0.LI.d0.LM_MBB0.RI0
