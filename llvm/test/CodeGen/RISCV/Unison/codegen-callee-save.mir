# Test: Value preserved across call via callee-saved register.
#
# RUN: llc -mtriple=riscv64 -load %libunison -run-pass=regallocunison %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: codegen_callee_save
# CHECK: ADJCALLSTACKDOWN
# CHECK: PseudoCALL target-flags(riscv-call) @external_func
# CHECK: ADJCALLSTACKUP
# CHECK: $x10 = COPY
# CHECK: PseudoRET implicit $x10
--- |
  declare void @external_func()
  define i64 @codegen_callee_save(i64 %a) {
    call void @external_func()
    ret i64 %a
  }
...
---
name:            codegen_callee_save
tracksRegLiveness: true
frameInfo:
  adjustsStack:    true
body:             |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $x2, implicit $x2
    PseudoCALL target-flags(riscv-call) @external_func, csr_ilp32d_lp64d, implicit-def dead $x1, implicit-def $x2
    ADJCALLSTACKUP 0, 0, implicit-def dead $x2, implicit $x2
    $x10 = COPY %0
    PseudoRET implicit $x10
...
