# Test: Pure instructions can be reordered by the solver.
# Three independent ADDIs with no barriers between them.
# The solver is free to schedule them in any order.
# The makespan objective should still produce a valid schedule.
#
# RUN: llc -mtriple=riscv64 -load %libunison -run-pass=regallocunison \
# RUN:   -unison-preserve-orig-instr-order=false %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: sched_pure_reorder
# CHECK: $x10 = ADDI $x0, 1
# CHECK: $x11 = ADDI $x0, 2
# CHECK: $x12 = ADDI $x0, 3
# CHECK: SD $x10, $x0, 0
# CHECK: SD $x11, $x0, 8
# CHECK: SD $x12, $x0, 16
# CHECK: PseudoRET
--- |
  define void @sched_pure_reorder() {
    ret void
  }
...
---
name:            sched_pure_reorder
tracksRegLiveness: true
body:             |
  bb.0:
    ; Three independent pure instructions. No barriers.
    $x10 = ADDI $x0, 1
    $x11 = ADDI $x0, 2
    $x12 = ADDI $x0, 3
    ; Use all three at the end (store is a barrier).
    SD $x10, $x0, 0 :: (store (s64))
    SD $x11, $x0, 8 :: (store (s64))
    SD $x12, $x0, 16 :: (store (s64))
    PseudoRET
...
