# Test: Two busy regions with different available registers.
# Region 1: all caller-saved regs busy EXCEPT $x12. Vreg must be in $x12.
# Region 2: all caller-saved regs busy EXCEPT $x13. Vreg must be in $x13.
# Between the regions, the solver must insert a COPY from $x12 to $x13.
#
# Timeline:
#   def %0  |  region1 ($x12 free)  |  region2 ($x13 free)  |  use %0
#
# Expected: %0 starts in $x12, gets copied to $x13 between regions.
#
# RUN: llc -mtriple=riscv64 -load %libunison -run-pass=regallocunison %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: name: copy_between_regions
# CHECK: $x8 = COPY $x10
# CHECK: $x10 = ADDI $x0, 1
# CHECK: SD $x10, $x0, 0
# CHECK: $x10 = COPY $x8
# CHECK: PseudoRET
--- |
  define i64 @copy_between_regions(i64 %val) {
    ret i64 %val
  }
...
---
name:            copy_between_regions
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
body:             |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10

    ; Region 1: occupy all caller-saved except $x12.
    ; Each pair (def + use) creates a live physreg range.
    $x10 = ADDI $x0, 1
    $x11 = ADDI $x0, 2
    ; $x12 intentionally left free
    $x13 = ADDI $x0, 4
    $x14 = ADDI $x0, 5
    $x15 = ADDI $x0, 6
    $x16 = ADDI $x0, 7
    $x17 = ADDI $x0, 8
    $x5 = ADDI $x0, 9
    $x6 = ADDI $x0, 10
    $x7 = ADDI $x0, 11
    $x28 = ADDI $x0, 12
    $x29 = ADDI $x0, 13
    $x30 = ADDI $x0, 14
    $x31 = ADDI $x0, 15
    ; Use them all so they're live through region 1.
    SD $x10, $x0, 0 :: (store (s64))
    SD $x11, $x0, 8 :: (store (s64))
    SD $x13, $x0, 16 :: (store (s64))
    SD $x14, $x0, 24 :: (store (s64))
    SD $x15, $x0, 32 :: (store (s64))
    SD $x16, $x0, 40 :: (store (s64))
    SD $x17, $x0, 48 :: (store (s64))
    SD $x5, $x0, 56 :: (store (s64))
    SD $x6, $x0, 64 :: (store (s64))
    SD $x7, $x0, 72 :: (store (s64))
    SD $x28, $x0, 80 :: (store (s64))
    SD $x29, $x0, 88 :: (store (s64))
    SD $x30, $x0, 96 :: (store (s64))
    SD $x31, $x0, 104 :: (store (s64))

    ; Region 2: occupy all caller-saved except $x13.
    $x10 = ADDI $x0, 21
    $x11 = ADDI $x0, 22
    $x12 = ADDI $x0, 23
    ; $x13 intentionally left free
    $x14 = ADDI $x0, 25
    $x15 = ADDI $x0, 26
    $x16 = ADDI $x0, 27
    $x17 = ADDI $x0, 28
    $x5 = ADDI $x0, 29
    $x6 = ADDI $x0, 30
    $x7 = ADDI $x0, 31
    $x28 = ADDI $x0, 32
    $x29 = ADDI $x0, 33
    $x30 = ADDI $x0, 34
    $x31 = ADDI $x0, 35
    SD $x10, $x0, 0 :: (store (s64))
    SD $x11, $x0, 8 :: (store (s64))
    SD $x12, $x0, 16 :: (store (s64))
    SD $x14, $x0, 24 :: (store (s64))
    SD $x15, $x0, 32 :: (store (s64))
    SD $x16, $x0, 40 :: (store (s64))
    SD $x17, $x0, 48 :: (store (s64))
    SD $x5, $x0, 56 :: (store (s64))
    SD $x6, $x0, 64 :: (store (s64))
    SD $x7, $x0, 72 :: (store (s64))
    SD $x28, $x0, 80 :: (store (s64))
    SD $x29, $x0, 88 :: (store (s64))
    SD $x30, $x0, 96 :: (store (s64))
    SD $x31, $x0, 104 :: (store (s64))

    ; Use %0 — must be in $x13 now.
    $x10 = COPY %0
    PseudoRET implicit $x10
...
