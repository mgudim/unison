# Scenario 6: Store in A, reload in B — cross-block spill.
# StoreMove in A spills to memory, LiveOutUse chooses StoreMove,
# congruence propagates memory to LiveInDef in B.
# StoreMove in B uses COPY_MEM (memory→memory).
# LoadMove in B reloads from memory (COPY_LOAD).
MBB0.RI0.d0.SM.active = 1
MBB0.RI0.d0.SM.ins = COPY_STORE
MBB0.LO.use[1].choice = MBB0.RI0.d0.SM
MBB1.LI.d1.SM.active = 1
MBB1.LI.d1.SM.ins = COPY_MEM
MBB1.LI.d1.LM_MBB1.RI0.active = 1
MBB1.LI.d1.LM_MBB1.RI0.ins = COPY_LOAD
MBB1.RI0.use[0].choice = MBB1.LI.d1.LM_MBB1.RI0
