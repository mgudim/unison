# Test: No-spill code generation — force all CopyOps inactive.
# A single ADDW with two physreg inputs. No register pressure.
#
# RUN: llc -mtriple=riscv64 -load %libunison -regalloc=unison \
# RUN:   -unison-preassign=%S/codegen-no-spill.vars %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: codegen_no_spill:
# CHECK:       addw a0, a0, a1
# CHECK-NEXT:  ret
--- |
  define signext i32 @codegen_no_spill(i32 signext %a, i32 signext %b) {
    %c = add i32 %a, %b
    ret i32 %c
  }
...
---
name:            codegen_no_spill
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10, $x11
    %0:gpr = ADDW $x10, $x11
    $x10 = COPY %0
    PseudoRET implicit $x10
...
