# Test: Value live across basic blocks — must pass through in the same register.
# Pre-assign to verify congruence constraint works.
#
# RUN: llc -mtriple=riscv64 -load %libunison -regalloc=unison \
# RUN:   -unison-preassign=%S/codegen-cross-bb.vars %s -o - \
# RUN:   | FileCheck %s

# CHECK-LABEL: codegen_cross_bb:
# CHECK:       bnez
# CHECK:       li a0, 0
# CHECK:       ret
--- |
  define i64 @codegen_cross_bb(i64 %a) {
  entry:
    %cmp = icmp sgt i64 %a, 0
    br i1 %cmp, label %then, label %else
  then:
    ret i64 %a
  else:
    ret i64 0
  }
...
---
name:            codegen_cross_bb
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $x10
    %0:gpr = COPY $x10
    BLT $x0, %0, %bb.1
    PseudoBR %bb.2

  bb.1:
    $x10 = COPY %0
    PseudoRET implicit $x10

  bb.2:
    $x10 = ADDI $x0, 0
    PseudoRET implicit $x10
...
